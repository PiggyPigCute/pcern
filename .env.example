# Copier ce fichier en `.env` (chargé automatiquement via dotenv) et le
# remplir, ou fournir ces variables via pm2/le shell qui lance le process.

# Token du bot Discord (portail développeur Discord > Bot > Reset Token)
DISCORD_TOKEN=

# ID du serveur (clic droit sur le serveur > Copier l'ID, mode développeur activé)
GUILD_ID=

# ID du salon forum à relier (clic droit sur le salon > Copier l'ID)
FORUM_CHANNEL_ID=

# URL publique du site (sans slash final) — utilisée pour les liens de
# vérification email, l'avatar par défaut, et le redirect OAuth Discord
SITE_URL=https://portail.ernestie.fr

# OAuth2 Discord ("Connexion avec Discord") — même application que le bot,
# onglet OAuth2 du portail développeur. Ajouter comme redirect URI :
# ${SITE_URL}/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# SMTP (optionnel) — sans ça, les comptes créés par email sont
# automatiquement vérifiés (voir src/mailer.js)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Port d'écoute du serveur web
PORT=3006
