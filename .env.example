# Copier ce fichier en `.env` (non versionné) et le remplir, ou fournir ces
# variables via pm2/le shell qui lance le process (aucune dépendance dotenv
# n'est utilisée ici, comme pour les autres projets du dossier web/).

# Token du bot Discord (portail développeur Discord > Bot > Reset Token)
DISCORD_TOKEN=

# ID du serveur (clic droit sur le serveur > Copier l'ID, mode développeur activé)
GUILD_ID=

# ID du salon forum à relier (clic droit sur le salon > Copier l'ID)
FORUM_CHANNEL_ID=

# Port d'écoute du serveur web
PORT=3006
